cabal-version:      3.0
name:               initiative
version:            0.1.0.0
synopsis:
    Organizing TTRPG and other similar groups to find timeslots for games

-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             oliverpauffley
maintainer:         mrpauffley@gmail.com
-- copyright:
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common common-options
    ghc-options: -Wall
    build-depends: relude
    mixins: base hiding (Prelude)
          , relude (Relude as Prelude)
          , relude
    default-extensions:   BangPatterns
                          ConstraintKinds
                          DataKinds
                          DeriveGeneric
                          DerivingStrategies
                          DerivingVia
                          FlexibleContexts
                          FlexibleInstances
                          GeneralizedNewtypeDeriving
                          InstanceSigs
                          KindSignatures
                          LambdaCase
                          MultiParamTypeClasses
                          OverloadedStrings
                          OverloadedLabels
                          RecordWildCards
                          ScopedTypeVariables
                          TypeApplications
                          TypeFamilies
                          TypeOperators


library
    import:           common-options
    exposed-modules:
                      -- Application monad setup
                      Lib
                      Lib.App
                      Lib.App.Env
                      Lib.App.Error
                      Lib.App.Monad

                      Lib.Config

                      -- Effects
                      Lib.Effects.Log

                      -- Database
                      Lib.Db
                      Lib.Db.Functions
                      Lib.Db.Schema
                      Lib.Db.Game
                      Lib.Db.Player
                      Lib.Db.Availability
                      Lib.Db.UserSession

                      -- Server
                      Lib.Server
                      Lib.Server.Auth
                      Lib.Server.Game
                      Lib.Server.Availability
                      Lib.Server.Common


                      -- Core types
                      Lib.Core.Game
                      Lib.Core.Interval
                      Lib.Core.Player
                      Lib.Core.UserSession
                      Lib.Core.Availability

                      -- Booking
                      Lib.Core.Booking
                      
                      
    build-depends:    base ^>=4.19.2.0
                    , aeson
                    , lens
                    , tomland
                    , mtl
                    , postgresql-simple
                    , resource-pool
                    , servant
                    , servant-client
                    , servant-server
                    , case-insensitive
                    , http-types
                    , text
                    , time
                    , wai
                    , wai-extra
                    , warp
                    , co-log
                    , uuid
                    , http-client
                    , http-conduit
                    , uri-bytestring
                    , array
                    , nonempty-containers
                    , servant-auth-server
                    , jose >= 0.11
                    , cookie
    hs-source-dirs:   src
    default-language: Haskell2010

executable initiative
    import:           common-options
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.19.2.0,
        initiative
    pkgconfig-depends: zlib
    hs-source-dirs:   app
    default-language: Haskell2010

library test-common
  import:          common-options
  visibility:      private
  default-language: Haskell2010
  hs-source-dirs:  test/common
  exposed-modules:
    Test.Common
    Test.Assert
  build-depends:
    base,
    initiative,
    hedgehog,
    hspec,
    hspec-core,
    postgresql-simple

test-suite initiative-unit-tests
    import:           common-options
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test/unit
    main-is:          Main.hs
    other-modules: Lib.Core.BookingSpec
    build-tool-depends: hspec-discover:hspec-discover == 2.*
    build-depends:
        base ^>=4.19.2.0
      , initiative
      , initiative:test-common
      , hedgehog
      , hspec-hedgehog
      , mtl
      , hspec
      , hspec-core
      , nonempty-containers


executable initiative-integration-tests
    import:           common-options
    default-language: Haskell2010
    other-modules:    Test.Server
    hs-source-dirs:   test/integration
    main-is:          Main.hs
    build-depends:
        base ^>=4.19.2.0
      , initiative
      , initiative:test-common
      , resource-pool
      , mtl
      , hspec
      , hspec-core
      , uuid
      , co-log
      , time
